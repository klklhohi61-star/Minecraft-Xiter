# ─── Minecraft Server ──────────────────────────────────────────────────────────
BOT_HOST=your-server.falixsrv.me
BOT_PORT=25565
BOT_USERNAME=XiterBot
MC_VERSION=1.20.1

# ─── Authentication ────────────────────────────────────────────────────────────
# Use 'offline' for cracked/offline-mode servers (no account needed)
# Use 'microsoft' for premium Java Edition servers (Microsoft/Mojang account)
#   → When 'microsoft' is set, the bot will print a device code on first run.
#     Open https://microsoft.com/devicelogin, enter the code, and sign in with
#     your Microsoft account. The token is cached automatically for future runs.
BOT_AUTH=offline

# ─── Bot behaviour ─────────────────────────────────────────────────────────────
RECONNECT_DELAY=10000    # ms before reconnecting after disconnect
AFK_INTERVAL=30000       # ms between anti-AFK actions

# ─── In-game commands ─────────────────────────────────────────────────────────
CHAT_PREFIX=!            # prefix for bot commands (e.g. !ping)
OWNER_USERNAME=          # your in-game name – unlocks !stop and !reconnect

# ─── Render.com (set automatically – leave blank locally) ─────────────────────
PORT=3000
