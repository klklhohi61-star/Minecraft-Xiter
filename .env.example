# ─── Server Pool ───────────────────────────────────────────────────────────────
# Option A — list multiple servers (comma-separated host:port).
# The bot tries them in order and locks onto the first one it can join.
# BOT_SERVERS=villainsmpknowledge.falixsrv.me:20013,162.55.28.90:20008

# Option B — single server (used when BOT_SERVERS is not set)
BOT_HOST=villainsmpknowledge.falixsrv.me
BOT_PORT=20013

# ─── Bot Settings ──────────────────────────────────────────────────────────────
BOT_USERNAME=XiterBot
MC_VERSION=1.20.1

# 'offline' for cracked/offline-mode servers (no account needed)
# 'microsoft' for premium Java Edition (shows device code on dashboard)
BOT_AUTH=offline

# ─── Behaviour ─────────────────────────────────────────────────────────────────
RECONNECT_DELAY=15000    # ms before first retry (doubles each attempt, max 120s)
AFK_INTERVAL=30000       # ms between anti-AFK actions

# ─── Commands ──────────────────────────────────────────────────────────────────
CHAT_PREFIX=!            # prefix for in-game commands
OWNER_USERNAME=          # your in-game name — unlocks !stop and !reconnect

# ─── Render.com (injected automatically — leave blank locally) ─────────────────
PORT=3000
